{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@repo/design-system-ui/lib/*": [
        "./landing-ui/design-system/lib/*"
      ],
      "@repo/design-system-ui/assets/*": [
        "./landing-ui/design-system/assets/*"
      ],
      "@repo/design-system-ui/*": [
        "./landing-ui/design-system/components/*"
      ],
      "@repo/ando-hero-ui/*": [
        "./landing-ui/ando-hero/*"
      ],
      "@/components/*": [
        "./landing-ui/components/*"
      ],
      "@/lib/*": [
        "./landing-ui/lib/*"
      ],
      "#components/*": [
        "./landing-ui/design-system/components/*"
      ],
      "#lib/*": [
        "./landing-ui/design-system/lib/*"
      ],
      "@repo/ando-hero-ui": [
        "./landing-ui/ando-hero/index.ts"
      ],
      "@/app/*": [
        "./app/landing-page/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "archive"
  ]
}
